@model ClienteFormDto
@{
    var titulo = Model.IsEdicao ? "Editar Cliente" : "Novo Cliente";
}

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@titulo</h4>
            <p class="text-muted mb-0">Preencha os dados do cliente.</p>
        </div>
    </div>

    <form asp-action="@(Model.IsEdicao ? "Editar" : "Criar")" method="post">
        @Html.AntiForgeryToken()

        @if (Model.IsEdicao)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
             style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
        </div>

        <!-- Dados Pessoais -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Dados Pessoais</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome completo">
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CpfCnpj" class="form-label">CPF/CNPJ</label>
                        <input asp-for="CpfCnpj" class="form-control" placeholder="000.000.000-00">
                    </div>
                </div>
            </div>
        </div>

        <!-- Contato -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-telephone me-2"></i>Contato</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Telefone" class="form-label">Telefone</label>
                        <input asp-for="Telefone" class="form-control" placeholder="(00) 0000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WhatsApp" class="form-label">WhatsApp</label>
                        <input asp-for="WhatsApp" class="form-control" placeholder="(00) 00000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="email@exemplo.com">
                    </div>
                </div>
                <div class="form-text mt-2">Informe pelo menos telefone ou WhatsApp.</div>
            </div>
        </div>

        <!-- Endereço -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Endereço</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Endereco" class="form-label">Endereço</label>
                        <input asp-for="Endereco" class="form-control" placeholder="Rua, número">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bairro" class="form-label">Bairro</label>
                        <input asp-for="Bairro" class="form-control">
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Cidade" class="form-label">Cidade</label>
                        <input asp-for="Cidade" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Estado" class="form-label">Estado</label>
                        <input asp-for="Estado" class="form-control" maxlength="2" placeholder="UF">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Cep" class="form-label">CEP</label>
                        <input asp-for="Cep" class="form-control" placeholder="00000-000">
                    </div>
                </div>
            </div>
        </div>

        <!-- Observações -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>Observações</h6>
            </div>
            <div class="card-body">
                <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Observações sobre o cliente..."></textarea>
            </div>
        </div>

        @if (Model.IsEdicao)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox">
                        <label asp-for="Ativo" class="form-check-label">Cliente Ativo</label>
                    </div>
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Salvar
            </button>
        </div>
    </form>
</div>
