@model IEnumerable<ClienteListagemDto>
@{
    var pesquisa = ViewData["Pesquisa"] as string;
    var situacao = ViewData["Situacao"] as string ?? "ativos";
}

<div class="fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-0">Gerencie os clientes da assistência técnica.</p>
        </div>
        <a asp-action="Criar" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Novo Cliente
        </a>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="pesquisa" class="form-control" placeholder="Pesquisar por nome, CPF/CNPJ, telefone..."
                               value="@pesquisa">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="situacao" class="form-select">
                        <option value="ativos" selected="@(situacao == "ativos")">Ativos</option>
                        <option value="inativos" selected="@(situacao == "inativos")">Inativos</option>
                        <option value="todos" selected="@(situacao == "todos")">Todos</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th class="hide-mobile">CPF/CNPJ</th>
                                <th>Telefone</th>
                                <th class="hide-mobile">WhatsApp</th>
                                <th class="hide-mobile">Cidade</th>
                                <th>Status</th>
                                <th class="hide-mobile">Cadastro</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@cliente.Nome</strong>
                                    </td>
                                    <td class="hide-mobile">@(cliente.CpfCnpj ?? "-")</td>
                                    <td>@(cliente.Telefone ?? "-")</td>
                                    <td class="hide-mobile">@(cliente.WhatsApp ?? "-")</td>
                                    <td class="hide-mobile">@(cliente.Cidade ?? "-")</td>
                                    <td>
                                        @if (cliente.Ativo)
                                        {
                                            <span class="badge bg-success">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inativo</span>
                                        }
                                    </td>
                                    <td class="hide-mobile">@cliente.DataCadastro.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Detalhes" asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-outline-primary" title="Visualizar">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Editar" asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (cliente.Ativo)
                                            {
                                                <form asp-action="Inativar" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Inativar"
                                                            onclick="return confirm('Deseja inativar este cliente?')">
                                                        <i class="bi bi-person-dash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Reativar" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Reativar"
                                                            onclick="return confirm('Deseja reativar este cliente?')">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people d-block"></i>
                    <h6>Nenhum cliente encontrado</h6>
                    <p class="text-muted">
                        @if (!string.IsNullOrWhiteSpace(pesquisa))
                        {
                            <span>Nenhum resultado para "@pesquisa".</span>
                        }
                        else
                        {
                            <span>Cadastre o primeiro cliente da assistência.</span>
                        }
                    </p>
                    <a asp-action="Criar" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Cadastrar Cliente
                    </a>
                </div>
            }
        </div>
    </div>
</div>
