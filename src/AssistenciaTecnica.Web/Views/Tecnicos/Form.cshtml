@model TecnicoFormDto
@{
    var titulo = Model.IsEdicao ? $"Editar Técnico" : "Novo Técnico";
}

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@titulo</h4>
            <p class="text-muted mb-0">
                @if (Model.IsEdicao)
                {
                    <span>Atualize as informações do técnico.</span>
                }
                else
                {
                    <span>Preencha os dados para cadastrar um novo técnico.</span>
                }
            </p>
        </div>
    </div>

    <form asp-action="@(Model.IsEdicao ? "Editar" : "Criar")" method="post">
        @Html.AntiForgeryToken()

        @if (Model.IsEdicao)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
             style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-person-gear me-2"></i>Dados do Técnico</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome completo do técnico">
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Especialidade" class="form-label">Especialidade</label>
                        <input asp-for="Especialidade" class="form-control" placeholder="Ex: Smartphones, Notebooks, Tablets...">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-telephone me-2"></i>Contato</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Telefone" class="form-label">Telefone</label>
                        <input asp-for="Telefone" class="form-control" placeholder="(00) 0000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WhatsApp" class="form-label">WhatsApp</label>
                        <input asp-for="WhatsApp" class="form-control" placeholder="(00) 00000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="tecnico@email.com">
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsEdicao)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-toggle-on me-2"></i>Status</h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox">
                        <label asp-for="Ativo" class="form-check-label">Técnico ativo</label>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Salvar
            </button>
        </div>
    </form>
</div>
