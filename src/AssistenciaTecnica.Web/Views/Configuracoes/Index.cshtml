@model ConfiguracaoEmpresaFormDto

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <div>
            <h4 class="mb-0">Configurações da Assistência</h4>
            <p class="text-muted mb-0">Configure os dados da sua assistência técnica.</p>
        </div>
    </div>

    <form asp-action="Salvar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="LogoCaminho" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
             style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-building me-2"></i>Dados da Empresa</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label">Nome da Assistência <span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome da sua assistência técnica">
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CpfCnpj" class="form-label">CPF/CNPJ</label>
                        <input asp-for="CpfCnpj" class="form-control" placeholder="00.000.000/0000-00">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-image me-2"></i>Logo da Empresa</h6>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        @if (!string.IsNullOrEmpty(Model.LogoCaminho))
                        {
                            <img src="@Model.LogoCaminho" alt="Logo" class="rounded border" style="max-height: 80px; max-width: 200px;" />
                        }
                        else
                        {
                            <div class="border rounded d-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 80px;">
                                <i class="bi bi-image text-muted fs-3"></i>
                            </div>
                        }
                    </div>
                    <div class="col">
                        <label asp-for="LogoArquivo" class="form-label">Enviar novo logo</label>
                        <input asp-for="LogoArquivo" class="form-control" type="file" accept="image/*" />
                        <div class="form-text">Formatos aceitos: JPG, PNG, GIF, SVG. Tamanho máximo: 2MB.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-telephone me-2"></i>Contato</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Telefone" class="form-label">Telefone</label>
                        <input asp-for="Telefone" class="form-control" placeholder="(00) 0000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WhatsApp" class="form-label">WhatsApp</label>
                        <input asp-for="WhatsApp" class="form-control" placeholder="(00) 00000-0000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Endereco" class="form-label">Endereço</label>
                        <input asp-for="Endereco" class="form-control" placeholder="Rua, número - Bairro">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Ordem de Serviço</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="PrazoPadraoGarantiaDias" class="form-label">Prazo Padrão de Garantia (dias)</label>
                        <input asp-for="PrazoPadraoGarantiaDias" class="form-control" type="number" min="0">
                        <div class="form-text">Prazo padrão aplicado a novas ordens de serviço.</div>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="TextoPadraoOrdem" class="form-label">Texto Padrão da Ordem de Serviço</label>
                        <textarea asp-for="TextoPadraoOrdem" class="form-control" rows="5"
                                  placeholder="Texto que aparecerá nas impressões da ordem de serviço..."></textarea>
                        <div class="form-text">Este texto será utilizado em futuras impressões de OS.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Salvar Configurações
            </button>
        </div>
    </form>
</div>
