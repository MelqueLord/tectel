@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="fade-in">
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Abertas</p>
                            <h3 class="mb-0 fw-bold">@Model.OrdensAbertas</h3>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-folder2-open"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Em Manutenção</p>
                            <h3 class="mb-0 fw-bold">@Model.EmManutencao</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-wrench"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Aguard. Aprovação</p>
                            <h3 class="mb-0 fw-bold">@Model.AguardandoAprovacao</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Aguard. Retirada</p>
                            <h3 class="mb-0 fw-bold">@Model.AguardandoRetirada</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Entregues (Mês)</p>
                            <h3 class="mb-0 fw-bold">@Model.ConcluidasNoMes</h3>
                        </div>
                        <div class="stat-icon bg-secondary bg-opacity-10 text-secondary">
                            <i class="bi bi-truck"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Estoque Baixo</p>
                            <h3 class="mb-0 fw-bold text-danger">@Model.ProdutosEstoqueBaixo</h3>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Ordens Recentes</h6>
            <a asp-controller="OrdensServico" asp-action="Index" class="btn btn-sm btn-outline-primary">
                Ver Todas
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.OrdensRecentes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Aparelho</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Valor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ordem in Model.OrdensRecentes)
                            {
                                <tr>
                                    <td><strong>@ordem.Numero</strong></td>
                                    <td>@ordem.ClienteNome</td>
                                    <td>@ordem.AparelhoDescricao</td>
                                    <td>@ordem.DataEntrada.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @switch (ordem.Status)
                                        {
                                            case StatusOrdemServico.Aberta:
                                                <span class="badge bg-primary">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.EmAnalise:
                                                <span class="badge bg-info">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.AguardandoAprovacao:
                                                <span class="badge bg-warning text-dark">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.EmManutencao:
                                                <span class="badge bg-orange text-dark" style="background-color: #fd7e14;">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.Concluida:
                                                <span class="badge bg-success">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.Entregue:
                                                <span class="badge bg-secondary">@ordem.StatusDescricao</span>
                                                break;
                                            case StatusOrdemServico.Cancelada:
                                                <span class="badge bg-danger">@ordem.StatusDescricao</span>
                                                break;
                                        }
                                    </td>
                                    <td>R$ @ordem.ValorTotal.ToString("N2")</td>
                                    <td>
                                        <a asp-controller="OrdensServico" asp-action="Detalhes" asp-route-id="@ordem.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-clipboard-check d-block"></i>
                    <h6>Nenhuma ordem cadastrada</h6>
                    <p class="text-muted">Abra a primeira ordem de serviço.</p>
                    <a asp-controller="OrdensServico" asp-action="Criar" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Nova Ordem
                    </a>
                </div>
            }
        </div>
    </div>
</div>
