@model AparelhoFormDto
@{
    var titulo = Model.IsEdicao ? "Editar Aparelho" : "Novo Aparelho";
    var clientes = ViewData["Clientes"] as IEnumerable<ClienteListagemDto> ?? [];
    var clienteSelecionado = ViewData["ClienteSelecionado"] as int?;
}

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@titulo</h4>
            <p class="text-muted mb-0">Preencha os dados do aparelho.</p>
        </div>
    </div>

    <form asp-action="@(Model.IsEdicao ? "Editar" : "Criar")" method="post">
        @Html.AntiForgeryToken()

        @if (Model.IsEdicao)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
             style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-person me-2"></i>Cliente</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="ClienteId" class="form-label">Cliente <span class="text-danger">*</span></label>
                        <select asp-for="ClienteId" class="form-select">
                            <option value="">Selecione um cliente</option>
                            @foreach (var cliente in clientes)
                            {
                                <option value="@cliente.Id" selected="@(cliente.Id == Model.ClienteId || cliente.Id == clienteSelecionado)">
                                    @cliente.Nome - @(cliente.Telefone ?? cliente.WhatsApp ?? "-")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-phone me-2"></i>Dados do Aparelho</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Tipo" class="form-label">Tipo <span class="text-danger">*</span></label>
                        <select asp-for="Tipo" class="form-select">
                            <option value="Celular">Celular</option>
                            <option value="Tablet">Tablet</option>
                            <option value="Notebook">Notebook</option>
                            <option value="Smartwatch">Smartwatch</option>
                            <option value="Outro">Outro</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Marca" class="form-label">Marca <span class="text-danger">*</span></label>
                        <input asp-for="Marca" class="form-control" placeholder="Samsung, Apple, etc.">
                        <span asp-validation-for="Marca" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Modelo" class="form-label">Modelo <span class="text-danger">*</span></label>
                        <input asp-for="Modelo" class="form-control" placeholder="Galaxy S23, iPhone 15, etc.">
                        <span asp-validation-for="Modelo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Cor" class="form-label">Cor</label>
                        <input asp-for="Cor" class="form-control" placeholder="Preto, Branco, etc.">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Imei" class="form-label">IMEI</label>
                        <input asp-for="Imei" class="form-control" placeholder="000000000000000">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NumeroSerie" class="form-label">Número de Série</label>
                        <input asp-for="NumeroSerie" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Senha e Estado</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SenhaDesbloqueio" class="form-label">Senha ou Padrão de Desbloqueio</label>
                        <input asp-for="SenhaDesbloqueio" class="form-control" type="password">
                        <div class="form-text">Esta informação é sensível e só aparece quando necessário.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EstadoAparelho" class="form-label">Estado do Aparelho</label>
                        <textarea asp-for="EstadoAparelho" class="form-control" rows="2"
                                  placeholder="Descreva o estado físico do aparelho..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-box me-2"></i>Itens e Observações</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="ItensEntregues" class="form-label">Itens Entregues</label>
                        <textarea asp-for="ItensEntregues" class="form-control" rows="2"
                                  placeholder="Carregador, capa, película, etc."></textarea>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Observacoes" class="form-label">Observações</label>
                        <textarea asp-for="Observacoes" class="form-control" rows="2"
                                  placeholder="Observações sobre o aparelho..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Salvar
            </button>
        </div>
    </form>
</div>
