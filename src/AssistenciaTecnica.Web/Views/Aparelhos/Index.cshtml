@model IEnumerable<AparelhoDto>
@{
    var pesquisa = ViewData["Pesquisa"] as string;
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-0">Gerencie os aparelhos cadastrados dos clientes.</p>
        </div>
        <a asp-action="Criar" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Novo Aparelho
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="pesquisa" class="form-control"
                               placeholder="Pesquisar por cliente, marca, modelo, IMEI..."
                               value="@pesquisa">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Pesquisar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Cliente</th>
                                <th>Tipo</th>
                                <th>Marca/Modelo</th>
                                <th class="hide-mobile">IMEI</th>
                                <th class="hide-mobile">Cor</th>
                                <th class="hide-mobile">Cadastro</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aparelho in Model)
                            {
                                <tr>
                                    <td><strong>@aparelho.ClienteNome</strong></td>
                                    <td>@aparelho.Tipo</td>
                                    <td>@aparelho.Marca @aparelho.Modelo</td>
                                    <td class="hide-mobile">@(aparelho.Imei ?? "-")</td>
                                    <td class="hide-mobile">@(aparelho.Cor ?? "-")</td>
                                    <td class="hide-mobile">@aparelho.DataCadastro.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Detalhes" asp-route-id="@aparelho.Id"
                                               class="btn btn-sm btn-outline-primary" title="Visualizar">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Editar" asp-route-id="@aparelho.Id"
                                               class="btn btn-sm btn-outline-secondary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="OrdensServico" asp-action="Criar"
                                               asp-route-clienteId="@aparelho.ClienteId" asp-route-aparelhoId="@aparelho.Id"
                                               class="btn btn-sm btn-outline-success" title="Criar OS">
                                                <i class="bi bi-clipboard-plus"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-phone d-block"></i>
                    <h6>Nenhum aparelho encontrado</h6>
                    <p class="text-muted">
                        @if (!string.IsNullOrWhiteSpace(pesquisa))
                        {
                            <span>Nenhum resultado para "@pesquisa".</span>
                        }
                        else
                        {
                            <span>Cadastre o primeiro aparelho da assistência.</span>
                        }
                    </p>
                    <a asp-action="Criar" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Cadastrar Aparelho
                    </a>
                </div>
            }
        </div>
    </div>
</div>
