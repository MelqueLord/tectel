@{
    var logoCaminho = ViewData["LogoCaminho"] as string;
}

@if (!string.IsNullOrEmpty(logoCaminho))
{
    <div class="d-flex align-items-center gap-2 mb-1">
        <img src="@logoCaminho" alt="Logo" style="max-height: 35px; max-width: 35px;" />
        <div>
            <div class="fw-bold text-white small">Tectel</div>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-1">
        <img src="~/images/tectel-logo.png" alt="Tectel" style="max-height: 35px; max-width: 35px;" />
        <div>
            <div class="fw-bold text-white small">Tectel</div>
        </div>
    </div>
}
