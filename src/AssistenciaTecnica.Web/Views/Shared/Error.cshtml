@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                <img src="~/images/tectel-logo.png" alt="Tectel" style="max-height: 50px;" class="mb-3" />
                <br />
                <i class="bi bi-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
            </div>
            <h1 class="display-5 fw-bold text-danger mb-3">Ops! Algo deu errado</h1>
            <p class="lead text-muted mb-4">
                Ocorreu um erro inesperado ao processar sua requisição.
                Nossa equipe foi notificada.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">
                    <strong>ID da Requisição:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <div class="d-flex gap-3 justify-content-center">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door"></i> Voltar ao Início
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </div>
    </div>
</div>
