@model List<Microsoft.AspNetCore.Identity.IdentityUser>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Usuários do Sistema</h5>
    <a asp-action="Criar" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Novo Usuário
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>E-mail</th>
                        <th>Status</th>
                        <th>Admin</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                <i class="bi bi-person-circle me-2 text-muted"></i>@user.Email
                            </td>
                            <td class="align-middle">
                                @if (user.LockoutEnd is null || user.LockoutEnd <= DateTimeOffset.UtcNow)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativo</span>
                                }
                            </td>
                            <td class="align-middle">
                                @if (user.Email == User.Identity?.Name)
                                {
                                    <span class="badge bg-primary">Você</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (user.Email != User.Identity?.Name)
                                {
                                    <form asp-action="Excluir" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Tem certeza que deseja excluir este usuário?')">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
