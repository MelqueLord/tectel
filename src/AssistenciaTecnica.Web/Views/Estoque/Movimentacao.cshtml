@model MovimentacaoEstoqueFormDto
@{
    var movimentacoes = ViewData["Movimentacoes"] as IEnumerable<MovimentacaoEstoque> ?? [];
}

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">Movimentação de Estoque</h4>
            <p class="text-muted mb-0">Produto: @Model.ProdutoNome</p>
        </div>
        <div class="ms-auto">
            <a asp-controller="Produtos" asp-action="Detalhes" asp-route-id="@Model.ProdutoId"
               class="btn btn-outline-primary">
                <i class="bi bi-eye me-2"></i>Ver Produto
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-arrow-down-circle text-success me-2"></i>Entrada</h6>
                </div>
                <div class="card-body">
                    <form asp-action="RegistrarEntrada" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProdutoId" />
                        <input type="hidden" asp-for="ProdutoNome" />

                        <div class="mb-3">
                            <label class="form-label">Quantidade</label>
                            <input name="Quantidade" type="number" class="form-control" min="1" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <input name="Motivo" type="text" class="form-control" placeholder="Ex: Compra de fornecedor">
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle me-2"></i>Registrar Entrada
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-arrow-up-circle text-danger me-2"></i>Saída</h6>
                </div>
                <div class="card-body">
                    <form asp-action="RegistrarSaida" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProdutoId" />
                        <input type="hidden" asp-for="ProdutoNome" />

                        <div class="mb-3">
                            <label class="form-label">Quantidade</label>
                            <input name="Quantidade" type="number" class="form-control" min="1" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <input name="Motivo" type="text" class="form-control" placeholder="Ex: Uso em OS">
                        </div>
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-dash-circle me-2"></i>Registrar Saída
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-gear text-warning me-2"></i>Ajuste</h6>
                </div>
                <div class="card-body">
                    <form asp-action="RegistrarAjuste" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProdutoId" />
                        <input type="hidden" asp-for="ProdutoNome" />

                        <div class="mb-3">
                            <label class="form-label">Nova Quantidade</label>
                            <input name="Quantidade" type="number" class="form-control" min="0" required>
                            <div class="form-text">Ajusta o estoque para este valor.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivo</label>
                            <input name="Motivo" type="text" class="form-control" placeholder="Ex: Inventário">
                        </div>
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-sliders me-2"></i>Registrar Ajuste
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Histórico de Movimentações</h6>
        </div>
        <div class="card-body p-0">
            @if (movimentacoes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Tipo</th>
                                <th>Quantidade</th>
                                <th>Motivo</th>
                                <th>OS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in movimentacoes)
                            {
                                <tr>
                                    <td>@mov.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @switch (mov.Tipo)
                                        {
                                            case TipoMovimentacao.Entrada:
                                                <span class="badge bg-success">Entrada</span>
                                                break;
                                            case TipoMovimentacao.Saida:
                                                <span class="badge bg-danger">Saída</span>
                                                break;
                                            case TipoMovimentacao.Ajuste:
                                                <span class="badge bg-warning text-dark">Ajuste</span>
                                                break;
                                        }
                                    </td>
                                    <td>@mov.Quantidade</td>
                                    <td>@(mov.Motivo ?? "-")</td>
                                    <td>
                                        @if (mov.OrdemServicoId.HasValue)
                                        {
                                            <a asp-controller="OrdensServico" asp-action="Detalhes" asp-route-id="@mov.OrdemServicoId">
                                                OS #@mov.OrdemServicoId
                                            </a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state py-4">
                    <i class="bi bi-arrow-left-right d-block"></i>
                    <h6>Nenhuma movimentação</h6>
                    <p class="text-muted">Este produto ainda não possui movimentações de estoque.</p>
                </div>
            }
        </div>
    </div>
</div>
