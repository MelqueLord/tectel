@model IEnumerable<AgendamentoDto>

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">@ViewData["Title"]</h4>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-calendar3 me-1"></i>Calendário
            </a>
            <a asp-action="Criar" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Novo Agendamento
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var agendamento in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-start border-4" style="border-color: @(agendamento.Cor ?? "#6c757d") !important;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">@agendamento.Titulo</h6>
                                @switch (agendamento.Status)
                                {
                                    case StatusAgendamento.Agendado:
                                        <span class="badge bg-primary">@agendamento.StatusDescricao</span>
                                        break;
                                    case StatusAgendamento.Confirmado:
                                        <span class="badge bg-info">@agendamento.StatusDescricao</span>
                                        break;
                                    case StatusAgendamento.Concluido:
                                        <span class="badge bg-success">@agendamento.StatusDescricao</span>
                                        break;
                                    case StatusAgendamento.Cancelado:
                                        <span class="badge bg-danger">@agendamento.StatusDescricao</span>
                                        break;
                                }
                            </div>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-clock me-1"></i>
                                @agendamento.DataInicio.ToString("HH:mm") - @agendamento.DataFim.ToString("HH:mm")
                            </p>
                            @if (!string.IsNullOrEmpty(agendamento.ClienteNome))
                            {
                                <p class="small mb-2">
                                    <i class="bi bi-person me-1"></i>@agendamento.ClienteNome
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(agendamento.Descricao))
                            {
                                <p class="small text-muted mb-0">@agendamento.Descricao</p>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="Detalhes" asp-route-id="@agendamento.Id" class="btn btn-sm btn-outline-primary w-100">
                                Ver Detalhes
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Nenhum agendamento para hoje</h5>
                <p class="text-muted">Crie um novo agendamento para começar.</p>
                <a asp-action="Criar" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Novo Agendamento
                </a>
            </div>
        </div>
    }
</div>
