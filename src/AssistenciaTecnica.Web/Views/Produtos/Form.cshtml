@model ProdutoFormDto
@{
    var titulo = Model.IsEdicao ? "Editar Produto" : "Novo Produto";
}

<div class="fade-in">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@titulo</h4>
            <p class="text-muted mb-0">Preencha os dados do produto.</p>
        </div>
    </div>

    <form asp-action="@(Model.IsEdicao ? "Editar" : "Criar")" method="post">
        @Html.AntiForgeryToken()

        @if (Model.IsEdicao)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
             style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")">
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-box me-2"></i>Identificação</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="Codigo" class="form-label">Código <span class="text-danger">*</span></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ex: PEC001">
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Nome" class="form-label">Nome <span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome do produto">
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Categoria" class="form-label">Categoria</label>
                        <input asp-for="Categoria" class="form-control" placeholder="Ex: Telas, Baterias, Acessórios">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Detalhes</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="2"
                                  placeholder="Descrição detalhada do produto..."></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Marca" class="form-label">Marca</label>
                        <input asp-for="Marca" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ModeloCompativel" class="form-label">Modelo Compatível</label>
                        <input asp-for="ModeloCompativel" class="form-control" placeholder="Ex: Galaxy S23, iPhone 15">
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-currency-dollar me-2"></i>Preços e Estoque</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="PrecoCusto" class="form-label">Preço de Custo</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input asp-for="PrecoCusto" class="form-control" type="number" step="0.01" min="0">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PrecoVenda" class="form-label">Preço de Venda</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input asp-for="PrecoVenda" class="form-control" type="number" step="0.01" min="0">
                        </div>
                    </div>
                    @if (!Model.IsEdicao)
                    {
                        <div class="col-md-3">
                            <label asp-for="QuantidadeEstoque" class="form-label">Quantidade Inicial</label>
                            <input asp-for="QuantidadeEstoque" class="form-control" type="number" min="0">
                        </div>
                    }
                    else
                    {
                        <div class="col-md-3">
                            <label class="form-label">Estoque Atual</label>
                            <input type="text" class="form-control" value="@Model.QuantidadeEstoque" readonly>
                        </div>
                    }
                    <div class="col-md-3">
                        <label asp-for="EstoqueMinimo" class="form-label">Estoque Mínimo</label>
                        <input asp-for="EstoqueMinimo" class="form-control" type="number" min="0">
                        <div class="form-text">Alerta quando atingir este nível.</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsEdicao)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="Ativo" class="form-check-input" type="checkbox">
                        <label asp-for="Ativo" class="form-check-label">Produto Ativo</label>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-2"></i>Salvar
            </button>
        </div>
    </form>
</div>
