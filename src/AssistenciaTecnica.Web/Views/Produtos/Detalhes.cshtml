@model ProdutoDto

<div class="fade-in">
    <div class="d-flex flex-wrap align-items-start gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="flex-grow-1">
            <h4 class="mb-0">@Model.Nome</h4>
            <p class="text-muted mb-0 small">Código: @Model.Codigo</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-controller="Estoque" asp-action="Movimentacao" asp-route-produtoId="@Model.Id"
           class="btn btn-outline-info btn-sm">
            <i class="bi bi-arrow-left-right me-1"></i>Estoque
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-box me-2"></i>Informações do Produto</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Código</dt>
                        <dd class="col-sm-8">@Model.Codigo</dd>

                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8">@Model.Nome</dd>

                        <dt class="col-sm-4">Categoria</dt>
                        <dd class="col-sm-8">@(Model.Categoria ?? "-")</dd>

                        <dt class="col-sm-4">Marca</dt>
                        <dd class="col-sm-8">@(Model.Marca ?? "-")</dd>

                        <dt class="col-sm-4">Compatível</dt>
                        <dd class="col-sm-8">@(Model.ModeloCompativel ?? "-")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Ativo)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-currency-dollar me-2"></i>Preços e Estoque</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Preço de Custo</dt>
                        <dd class="col-sm-7">R$ @Model.PrecoCusto.ToString("N2")</dd>

                        <dt class="col-sm-5">Preço de Venda</dt>
                        <dd class="col-sm-7">R$ @Model.PrecoVenda.ToString("N2")</dd>

                        <dt class="col-sm-5">Estoque Atual</dt>
                        <dd class="col-sm-7">
                            <span class="@(Model.QuantidadeEstoque <= Model.EstoqueMinimo ? "text-danger fw-bold" : "")">
                                @Model.QuantidadeEstoque unidades
                            </span>
                        </dd>

                        <dt class="col-sm-5">Estoque Mínimo</dt>
                        <dd class="col-sm-7">@Model.EstoqueMinimo unidades</dd>

                        <dt class="col-sm-5">Situação</dt>
                        <dd class="col-sm-7">
                            @if (Model.QuantidadeEstoque <= Model.EstoqueMinimo)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Estoque Baixo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">Normal</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Descricao))
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>Descrição</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Descricao</p>
                    </div>
                </div>
            </div>
        }

        <div class="col-12">
            <small class="text-muted">
                <i class="bi bi-calendar me-1"></i>
                Cadastrado em @Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")
            </small>
        </div>
    </div>
</div>
