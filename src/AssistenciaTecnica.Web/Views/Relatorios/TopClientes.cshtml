@model RelatorioTopClientesDto
@{
    ViewData["Title"] = "Top Clientes";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Top Clientes</h4>
            <p class="text-muted mb-0">Clientes que mais gastam no período</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <div class="row g-4">
        <!-- Gráfico -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Top 10 Clientes por Valor Gasto</h6>
                </div>
                <div class="card-body">
                    <canvas id="topClientesChart" height="400"></canvas>
                </div>
            </div>
        </div>

        <!-- Tabela -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-trophy me-2"></i>Ranking</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.TopClientes.Any())
                    {
                        <div class="list-group list-group-flush">
                            @{var rank = 1;}
                            @foreach (var cliente in Model.TopClientes)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        @if (rank <= 3)
                                        {
                                            <span class="badge bg-warning text-dark me-3 fs-6">@rank</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted me-3 fs-6" style="width: 28px; text-align: center;">@rank</span>
                                        }
                                        <div>
                                            <h6 class="mb-0">@cliente.Nome</h6>
                                            <small class="text-muted">@cliente.TotalOrdens ordens</small>
                                        </div>
                                    </div>
                                    <span class="text-success fw-bold">R$ @cliente.TotalGasto.ToString("N2")</span>
                                </div>
                                rank++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people text-muted fs-1"></i>
                            <p class="text-muted mt-2">Nenhum cliente encontrado</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('topClientesChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopClientes.Select(c => c.Nome))),
                datasets: [{
                    label: 'Total Gasto (R$)',
                    data: @Html.Raw(Json.Serialize(Model.TopClientes.Select(c => c.TotalGasto))),
                    backgroundColor: [
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(108, 117, 125, 0.8)',
                        'rgba(205, 127, 50, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 110, 253, 0.8)'
                    ],
                    borderColor: [
                        'rgba(255, 193, 7, 1)',
                        'rgba(108, 117, 125, 1)',
                        'rgba(205, 127, 50, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)',
                        'rgba(13, 110, 253, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'R$ ' + context.parsed.x.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'R$ ' + value.toLocaleString('pt-BR');
                            }
                        }
                    }
                }
            }
        });
    </script>
}
