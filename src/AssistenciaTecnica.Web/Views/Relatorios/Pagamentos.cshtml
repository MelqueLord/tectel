@model RelatorioPagamentosDto
@{
    ViewData["Title"] = "Relatório de Pagamentos";
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 fw-bold">Relatório de Pagamentos</h4>
            <p class="text-muted mb-0">Análise dos pagamentos por forma de pagamento</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Voltar
        </a>
    </div>

    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data Início</label>
                    <input type="date" name="dataInicio" class="form-control" value="@Model.DataInicio.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Data Fim</label>
                    <input type="date" name="dataFim" class="form-control" value="@Model.DataFim.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Card de Resumo -->
    <div class="row g-3 mb-4">
        <div class="col-md-12">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Total Pago no Período</p>
                            <h3 class="mb-0 fw-bold text-success">R$ @Model.TotalPago.ToString("N2")</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Gráfico -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Distribuição por Forma de Pagamento</h6>
                </div>
                <div class="card-body">
                    <canvas id="pagamentosChart" height="400"></canvas>
                </div>
            </div>
        </div>

        <!-- Tabela -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-table me-2"></i>Detalhamento</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.PagamentosPorForma.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Forma de Pagamento</th>
                                        <th>Quantidade</th>
                                        <th>Valor Total</th>
                                        <th>Percentual</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var forma in Model.PagamentosPorForma)
                                    {
                                        var percentual = Model.TotalPago > 0 ? forma.Valor / Model.TotalPago * 100 : 0;
                                        <tr>
                                            <td>
                                                <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: @forma.Cor;"></span>
                                                <strong>@forma.FormaPagamento</strong>
                                            </td>
                                            <td>@forma.Quantidade</td>
                                            <td class="text-success fw-bold">R$ @forma.Valor.ToString("N2")</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                        <div class="progress-bar" style="width: @percentual.ToString("F0")%; background-color: @forma.Cor;"></div>
                                                    </div>
                                                    <span class="text-muted small">@percentual.ToString("F1")%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-active">
                                        <td><strong>Total</strong></td>
                                        <td><strong>@Model.PagamentosPorForma.Sum(p => p.Quantidade)</strong></td>
                                        <td class="text-success fw-bold"><strong>R$ @Model.TotalPago.ToString("N2")</strong></td>
                                        <td><strong>100%</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-credit-card text-muted fs-1"></i>
                            <p class="text-muted mt-2">Nenhum pagamento no período selecionado</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('pagamentosChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.PagamentosPorForma.Select(p => p.FormaPagamento))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.PagamentosPorForma.Select(p => p.Valor))),
                    backgroundColor: @Html.Raw(Json.Serialize(Model.PagamentosPorForma.Select(p => p.Cor))),
                    borderWidth: 3,
                    borderColor: '#fff',
                    hoverBorderWidth: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            pointStyleWidth: 12,
                            font: {
                                size: 12
                            }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const value = context.parsed;
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': R$ ' + value.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    </script>
}
