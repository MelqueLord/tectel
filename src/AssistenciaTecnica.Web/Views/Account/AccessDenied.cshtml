@{
    Layout = "_LayoutLogin";
}

<div class="login-container">
    <div class="login-card text-center">
        <div class="brand-logo-wrapper mb-2">
            <img src="~/images/tectel-logo.png" alt="Tectel" class="brand-logo" />
        </div>
        <div class="mb-3">
            <i class="bi bi-shield-x text-danger" style="font-size: 2.5rem;"></i>
        </div>
        <h6 class="fw-bold mb-2">Acesso Negado</h6>
        <p class="text-muted small mb-3">Você não tem permissão para acessar esta página.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm w-100">
            <i class="bi bi-box-arrow-in-right me-2"></i>Voltar ao Login
        </a>
    </div>
</div>
