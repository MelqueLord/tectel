@model RegisterViewModel

@{
    Layout = "_LayoutLogin";
}

<div class="row justify-content-center align-items-center min-vh-100">
    <div class="col-11 col-sm-8 col-md-5 col-lg-4 col-xl-3">
        <div class="card shadow border-0" style="border-radius: 1rem;">
            <div class="card-body p-4 p-sm-5">
                <!-- Logo Section -->
                <div class="text-center mb-4">
                    <div class="brand-logo-wrapper mb-3">
                        <img src="~/images/tectel-logo.png" alt="Tectel" class="brand-logo" />
                    </div>
                    <h4 class="fw-bold mb-1" style="color: var(--primary);">Tectel</h4>
                    <p class="text-muted small mb-0">Criar nova conta</p>
                </div>

                <!-- Register Form -->
                <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="seu@email.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repita a senha" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-person-plus me-2"></i>Criar Conta
                    </button>
                </form>

                <div class="text-center mt-4">
                    <hr class="my-3" />
                    <p class="small text-muted mb-0">
                        Já tem conta?
                        <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-decoration-none fw-semibold">Entrar</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-3">
            <small class="text-muted">&copy; @DateTime.Now.Year Tectel - Todos os direitos reservados</small>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
